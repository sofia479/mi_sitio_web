life  #lyricvideo \n\n~\n\nCantoYo es un canal de lyric videos que tiene los videos oficiales de tus artistas favoritos. Suscríbete para ser notificado en el momento que un nuevo video esté disponible!\n\nCantoYo is a lyric video channel that brings you the official videos of your favorite artists. Subscribe to be notified when a new video comes out!","commandRuns":[{"startIndex":110,"length":33,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCIQ040EGAYiEwj8hLm2-4aWAxXlAtsBHUjiCIJInqW6yKqvtorgAcoBBCrwFVA=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU2hqd3kzVjVsdU5XNXZnUEoxbzUzX3xBR3JiS2FrWVRCQmVCRG84a1FJUUFkQWFNVHFMSDA2ZmxzbDFzU0ZyeFlJMm5ZNEtGTFFwLXdYdk1QWmt3LVVqRXJMdHdKVlM1a0NFWEZGM2hJX3dDQnJmQjRFVDJ4Q05HeFhx\u0026q=http%3A%2F%2Fbit.ly%2FCantoYo-Suscripcion\u0026v=4BTZeqkOkp4","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rU2hqd3kzVjVsdU5XNXZnUEoxbzUzX3xBR3JiS2FrWVRCQmVCRG84a1FJUUFkQWFNVHFMSDA2ZmxzbDFzU0ZyeFlJMm5ZNEtGTFFwLXdYdk1QWmt3LVVqRXJMdHdKVlM1a0NFWEZGM2hJX3dDQnJmQjRFVDJ4Q05HeFhx\u0026q=http%3A%2F%2Fbit.ly%2FCantoYo-Suscripcion\u0026v=4BTZeqkOkp4","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":180,"length":42,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCIQ040EGAYiEwj8hLm2-4aWAxXlAtsBHUjiCILKAQQq8BVQ","commandMetadata":{"webCommandMetadata":{"url":"/watch?v=bslNoCMejnw","webPageType":"WEB_PAGE_TYPE_WATCH","rootVe":3832}},"watchEndpoint":{"videoId":"bslNoCMejnw","startTimeSeconds":0,"watchEndpointSupportedOnesieConfig":{"html5PlaybackOnesieConfig":{"commonConfig":{"url":"https://rr1---sn-xuc-cvbee.googlevideo.com/initplayback?source=youtube\u0026oeis=1\u0026c=WEB\u0026oad=3200\u0026ovd=3200\u0026oaad=11000\u0026oavd=11000\u0026ocs=700\u0026oewis=1\u0026oputc=1\u0026olis=1\u0026ofpcc=1\u0026siu=1\u0026msp=1\u0026odepv=1\u0026id=6ec94da023